# Required for TMDB API requests used by catalog/profile enrichment flows
TMDB_BEARER=replace-with-tmdb-bearer-token

# Required for stable auth session signing (do not use the app fallback in deployed environments)
JWT_SECRET_KEY=replace-with-long-random-secret

# Optional override; default app value is already data/user_profiles.sqlite3
USER_PROFILE_DB_PATH=data/user_profiles.sqlite3
